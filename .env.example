PUBLIC_ORIGIN=https://router.example.com
# For local Compose (compose.local.yaml), use this origin instead:
# PUBLIC_ORIGIN=http://localhost:8080
# Paste the VALUES printed by scripts/bootstrap-secrets.sh, not paths.
# Keep single quotes around the Argon2id hash so its dollar signs stay literal.
ENCRYPTION_KEY=''
ADMIN_PASSWORD_HASH=''
# Behind Dokploy's Traefik, set this to 1 so sign-in throttling sees real client addresses.
# Leave it at 0 (the default) when clients connect to the router directly, as with compose.local.yaml.
# It must be a non-negative integer; any other value stops the router at startup.
# TRUSTED_PROXY_HOPS=1
